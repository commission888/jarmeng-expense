# Copy to .env.local and fill in. Never commit .env.local.

# ── Phase 1: required ────────────────────────────────────────────
# LINE Developers → your Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase → Project Settings → API
# SERVICE_ROLE bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── LIFF dashboard ───────────────────────────────────────────────
# LINE Developers → LIFF tab → LIFF ID
NEXT_PUBLIC_LIFF_ID=
# The LINE Login channel id the LIFF app belongs to. Required: it is what the
# server checks the ID token's audience against.
LINE_LOGIN_CHANNEL_ID=

# ── Phase 2: Gmail sync (scaffold — leave blank until implemented) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/gmail/callback

# ── Phase 3: cron routes ─────────────────────────────────────────
# Any long random string; must match the Authorization: Bearer header the
# scheduler sends. Generate: openssl rand -hex 32
CRON_SECRET=
